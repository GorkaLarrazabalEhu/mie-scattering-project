Cell[BoxData[{
 RowBox[{
  RowBox[{"nfread", "[", "file_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "f", ",", "dat", ",", "sdat", ",", "pos", ",", "n", ",", "c", ",", 
      "cdim", ",", "tdat", ",", "gmin", ",", "gmax", ",", "nb", ",", "bdat"}],
      "}"}], ",", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"OpenRead", "[", "file", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tdat", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"pos", "=", 
         RowBox[{"Find", "[", 
          RowBox[{"f", ",", "\"\< run number\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ToString", "[", "pos", "]"}], "==", "\"\<EndOfFile\>\""}],
           ",", 
          RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Read", "[", 
          RowBox[{"f", ",", "Number"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Read", "[", 
          RowBox[{"f", ",", "Number"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", ">", "0"}], ",", 
          RowBox[{"c", "=", 
           RowBox[{"ReadList", "[", 
            RowBox[{"f", ",", 
             RowBox[{"Table", "[", 
              RowBox[{"Number", ",", 
               RowBox[{"{", "4", "}"}]}], "]"}], ",", "n"}], "]"}]}], ",", 
          RowBox[{"c", "=", 
           RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sdat", "=", 
         RowBox[{"{", 
          RowBox[{"n", ",", "c"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Read", "[", 
          RowBox[{"f", ",", "Number"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", ">", "0"}], ",", 
          RowBox[{"c", "=", 
           RowBox[{"ReadList", "[", 
            RowBox[{"f", ",", "Number", ",", "n"}], "]"}]}], ",", 
          RowBox[{"c", "=", 
           RowBox[{"{", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"bdat", "=", 
         RowBox[{"{", 
          RowBox[{"n", ",", "c"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gmin", "=", 
         RowBox[{"Read", "[", 
          RowBox[{"f", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"Number", ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gmax", "=", 
         RowBox[{"Read", "[", 
          RowBox[{"f", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"Number", ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cdim", "=", 
         RowBox[{"Read", "[", 
          RowBox[{"f", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"Number", ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"cdim", "[", 
           RowBox[{"[", "1", "]"}], "]"}], 
          RowBox[{"cdim", "[", 
           RowBox[{"[", "2", "]"}], "]"}], 
          RowBox[{"cdim", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dat", "=", 
         RowBox[{"ReadList", "[", 
          RowBox[{"f", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"Number", ",", 
             RowBox[{"{", "27", "}"}]}], "]"}], ",", "n"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tdat", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"tdat", ",", 
           RowBox[{"{", 
            RowBox[{"cdim", ",", 
             RowBox[{"{", 
              RowBox[{"gmin", ",", "gmax"}], "}"}], ",", "sdat", ",", "bdat", 
             ",", "dat"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Close", "[", "f", "]"}], ";", "\[IndentingNewLine]", "tdat"}]}],
    "]"}]}], "\n", 
 RowBox[{
  RowBox[{"cplot", "[", "tdat_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cdim", ",", "rmin", ",", "rmax", ",", "splot", ",", "nb", ",", "bplot", 
      ",", "ep", ",", "b", ",", "arat"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cdim", "=", 
      RowBox[{"tdat", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cdim", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "1"}], ",", "1", ",", 
        RowBox[{
         RowBox[{"cdim", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "1"}], ",", "2", ",", 
        RowBox[{
         RowBox[{"cdim", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "\[Equal]", "1"}], ",", "3"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rmin", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"tdat", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"{", "p", "}"}]}], "]"}]}], ";", 
     RowBox[{"rmax", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"tdat", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", "p", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ppos", "=", 
      RowBox[{"tdat", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1", ",", "p"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ns", "=", 
      RowBox[{"tdat", "[", 
       RowBox[{"[", 
        RowBox[{"3", ",", "1"}], "]"}], "]"}]}], ";", 
     RowBox[{"sdat", "=", 
      RowBox[{"tdat", "[", 
       RowBox[{"[", 
        RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nis", "=", "0"}], ";", 
     RowBox[{"ispos", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"israd", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"t1", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"sdat", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "p"}], "]"}], "]"}], "-", "ppos"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"t1", "<", 
           RowBox[{"sdat", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "4"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"nis", "=", 
            RowBox[{"nis", "+", "1"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"ispos", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"ispos", ",", 
              RowBox[{"Drop", "[", 
               RowBox[{
                RowBox[{"sdat", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}], 
                ",", 
                RowBox[{"{", "p", "}"}]}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"israd", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"israd", ",", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"sdat", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "4"}], "]"}], "]"}], "^", "2"}], "-", 
                RowBox[{"t1", "^", "2"}]}], "]"}]}], "]"}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "ns"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"splot", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Circle", "[", 
         RowBox[{
          RowBox[{"ispos", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"israd", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nis"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nb", "=", 
      RowBox[{"tdat", "[", 
       RowBox[{"[", 
        RowBox[{"4", " ", ",", "1"}], "]"}], "]"}]}], ";", 
     RowBox[{"b", "=", 
      RowBox[{"tdat", "[", 
       RowBox[{"[", 
        RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bplot", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nb", ">", "0"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"rmin", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"b", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"rmax", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"b", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nb"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ep", "=", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"splot", ",", "bplot"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"arat", "=", 
      RowBox[{"AspectRatio", "->", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"p", "\[Equal]", "1"}], ",", 
         RowBox[{
          RowBox[{"cdim", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/", 
          RowBox[{"cdim", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"p", "\[Equal]", "2"}], ",", 
         RowBox[{
          RowBox[{"cdim", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/", 
          RowBox[{"cdim", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"p", "\[Equal]", "3"}], ",", 
         RowBox[{
          RowBox[{"cdim", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"cdim", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ep", ",", "arat"}], "}"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"readmstm", "[", 
   RowBox[{"file_", ",", "vars_", ",", "len_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "f", ",", "newlist", ",", "str", ",", "dat", ",", "pos", ",", "tdat", 
      ",", "t1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"OpenRead", "[", "file", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"newlist", "=", "\"\< input variables\>\""}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"str", "=", 
      RowBox[{"Find", "[", 
       RowBox[{"f", ",", "newlist"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dat", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"pos", "=", 
         RowBox[{"StreamPosition", "[", "f", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tdat", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Null", "[", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "vars", "]"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"str", "=", 
            RowBox[{"ToString", "[", 
             RowBox[{"Find", "[", 
              RowBox[{"f", ",", 
               RowBox[{"{", 
                RowBox[{"newlist", ",", 
                 RowBox[{"vars", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"str", "\[Equal]", 
              RowBox[{"ToString", "[", "EndOfFile", "]"}]}], ",", 
             RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"StringCases", "[", 
                RowBox[{"str", ",", 
                 RowBox[{"vars", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], "!=", "0"}],
              ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"t1", "=", 
               RowBox[{
                RowBox[{"Read", "[", 
                 RowBox[{"f", ",", 
                  RowBox[{"Table", "[", 
                   RowBox[{"Number", ",", 
                    RowBox[{"{", 
                    RowBox[{"len", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "}"}]}], "]"}]}], "]"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"len", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"tdat", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "=", "t1"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"SetStreamPosition", "[", 
            RowBox[{"f", ",", "pos"}], "]"}], ";"}], "\[IndentingNewLine]", 
          ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "vars", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dat", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"dat", ",", "tdat"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"str", "=", 
         RowBox[{"ToString", "[", 
          RowBox[{"Find", "[", 
           RowBox[{"f", ",", "newlist"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"str", "\[Equal]", 
           RowBox[{"ToString", "[", "EndOfFile", "]"}]}], ",", 
          RowBox[{"Break", "[", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "100000"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Close", "[", "f", "]"}], ";", "\[IndentingNewLine]", "dat"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.805924948971649*^9, 3.8059249937581997`*^9}, {
   3.806069431912916*^9, 3.806069849627768*^9}, {3.806070363541225*^9, 
   3.806070365410276*^9}, {3.806070446399054*^9, 3.806070450166584*^9}, {
